if(AXIAL_BUILD_APP)
  function(axial_swift_test name)
    add_executable(${name}-tests ${ARGN})
    axial_swift_platform(${name}-tests)
    target_compile_options(${name}-tests PRIVATE -parse-as-library)
    add_test(NAME ${name} COMMAND ${name}-tests)
    set_tests_properties(${name} PROPERTIES TIMEOUT 60 LABELS swift)
  endfunction()
  axial_swift_test(navigation app/TestNavigation.swift tests/test_navigation.swift)
  axial_swift_test(diagnostics app/Diagnostics.swift tests/diagnostic_history_tests.swift)
  axial_swift_test(session-log app/SessionLog.swift tests/session_log_tests.swift)
  axial_swift_test(web-setup app/WebSetup.swift tests/web_setup_tests.swift)
  axial_swift_test(app-instance app/AppInstance.swift tests/app_instance_tests.swift)
  foreach(test IN ITEMS model startup)
    if(test STREQUAL "startup")
      set(test_source tests/app_startup.swift)
    else()
      set(test_source tests/model_tests.swift)
    endif()
    axial_swift_test(${test} ${axial_app_sources} ${test_source})
    target_link_libraries(${test}-tests PRIVATE axial-bridge)
  endforeach()
  set_tests_properties(startup PROPERTIES LABELS "swift;gui" RUN_SERIAL TRUE)
endif()

